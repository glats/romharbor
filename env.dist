# HTTP listen address. Default: :8080.
HTTP_ADDR=:8080

# SQLite file path. Default: ./data/app.db. Do not use ?, # or % in the path.
# Pending migrations always run at startup, before optional seeds and HTTP serving.
DATABASE_PATH=./data/app.db

# Minimum level for both zerolog and slog. Default: info.
# Supported levels: trace, debug, info, warn, error, fatal, panic, disabled.
LOG_LEVEL=info

# true: readable terminal logs; false: JSON for cloud/structured log collection.
# Application default: false. This local-development template opts into true.
LOG_PRETTY=true

# Opt-in demo users (Ada Lovelace and Grace Hopper). Default: false.
# Embedded SQL seeds run in filename order, in one transaction after migrations.
# Repeated runs preserve existing users; deleted demo users return while enabled.
DB_SEED_ENABLED=false

# ROM library root; each platform downloads into its folder. Default: ./data/roms.
ROM_LIBRARY_PATH=./data/roms

# Directory of cached platform listings. Default: ./data/romcache.
ROM_CACHE_PATH=./data/romcache

# Comma-separated ROM sources: archive.org (default, portable), dlarchive, lolroms (opt-in).
ROM_SOURCES=archive.org

# How long a cached platform listing stays fresh. Default: 24h.
ROM_CACHE_TTL=24h

# Download worker policy. The worker reads these; the web server does not.
# Attempts per download before it is marked failed. Default: 3.
JOBS_MAX_ATTEMPTS=3

# Wait before the first retry; later retries wait four times as long. Default: 30s.
JOBS_RETRY_DELAY=30s

# How long finished downloads stay in the job list. Default: 720h (30 days).
JOBS_RETENTION=720h

# Longest a single download may run. Default: 6h.
JOBS_TIMEOUT=6h
